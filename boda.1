import sys
import runpy
import builtins
import importlib
import importlib.util
from importlib import abc
import traceback
from pathlib import Path

used_modules = set()

class TrackImportsFinder(abc.MetaPathFinder):
    def find_spec(self, fullname, path, target=None):
        try:
            spec = importlib.util.find_spec(fullname)
            if spec and spec.origin and spec.origin.endswith(".py"):
                used_modules.add(Path(spec.origin).resolve())
            return None
        except Exception:
            return None

def main(script_path):
    script_path = Path(script_path).resolve()
    sys.path.insert(0, str(script_path.parent))

    # Insert our custom import tracker
    sys.meta_path.insert(0, TrackImportsFinder())

    try:
        runpy.run_path(str(script_path), run_name="__main__")
    except Exception:
        print("Error during execution of the script:")
        traceback.print_exc()

    print("\nUsed Python files:")
    for module_path in sorted(used_modules):
        print(module_path)

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python track_imports.py <script_to_run.py>")
        sys.exit(1)
    main(sys.argv[1])
